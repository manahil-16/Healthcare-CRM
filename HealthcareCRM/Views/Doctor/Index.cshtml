@model IEnumerable<HealthcareCRM.Models.Doctor>

@{
    ViewData["Title"] = "Doctors";
}

<div class="container-fluid">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">🩺 Doctors</h2>
            <p class="text-muted">Manage all doctors</p>
        </div>
        <a href="/Doctor/Create" class="btn btn-primary btn-lg">+ Add Doctor</a>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Specialization</th>
                            <th>Phone</th>
                            <th>Schedule Days</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="text-center py-5">
                                        <div class="fs-1 mb-3">🩺</div>
                                        <h5 class="text-muted">No doctors found</h5>
                                        <p class="text-muted small">Add your first doctor to get started</p>
                                        <a href="/Doctor/Create" class="btn btn-primary mt-2">+ Add Doctor</a>
                                    </div>
                                </td>
                            </tr>
                        }
                        @foreach (var doctor in Model)
                        {
                            <tr>
                                <td>@doctor.Id</td>
                                <td><strong>@doctor.Name</strong></td>
                                <td>@doctor.Specialization</td>
                                <td>@doctor.Phone</td>
                                <td>@doctor.ScheduleDays</td>
                                <td>
                                    @if (doctor.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <a href="/Doctor/Edit/@doctor.Id"
                                       class="btn btn-warning btn-sm">Edit</a>
                                    <button type="button"
                                            class="btn btn-sm @(doctor.IsActive ? "btn-danger" : "btn-success")"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deactivateModal"
                                            onclick="setDoctorId(@doctor.Id, @doctor.IsActive.ToString().ToLower())">
                                        @(doctor.IsActive ? "Deactivate" : "Reactivate")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- Deactivate Modal -->
<div class="modal fade" id="deactivateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">Confirm Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalBody">Are you sure?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <a id="confirmButton" class="btn btn-warning">Confirm</a>
            </div>
        </div>
    </div>
</div>

<script>
    function setDoctorId(id, isActive) {
        document.getElementById("confirmButton").href = "/Doctor/Deactivate/" + id;
        document.getElementById("modalBody").innerText = isActive
            ? "Are you sure you want to deactivate this doctor?"
            : "Are you sure you want to reactivate this doctor?";
    }
</script>